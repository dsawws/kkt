[Unit]
Description=KKT Belorechensk Django (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data

WorkingDirectory=/var/www/html/django_admin

Environment=PATH=/var/www/html/django_admin/venv/bin
Environment=DJANGO_DEBUG=0
Environment=DJANGO_ALLOWED_HOSTS=new.kktbel.ru,kktbel.ru,www.kktbel.ru,127.0.0.1
Environment=DJANGO_CSRF_TRUSTED_ORIGINS=https://new.kktbel.ru,http://new.kktbel.ru

EnvironmentFile=/var/www/html/deploy/kktbel.env

ExecStart=/var/www/html/django_admin/venv/bin/gunicorn \
    techcollege_admin.wsgi:application \
    --bind 127.0.0.1:8041 \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
