# Рабочий файл на сервере (НЕ в Git):
#   /var/www/html/deploy/kktbel.env
#
# Создание:
#   cp /var/www/html/deploy/kktbel.env.example /var/www/html/deploy/kktbel.env
#   chmod 640 /var/www/html/deploy/kktbel.env
#   chown root:www-data /var/www/html/deploy/kktbel.env   # gunicorn читает EnvironmentFile
#   nano /var/www/html/deploy/kktbel.env                  # задать DJANGO_SECRET_KEY
#
# Подключается из systemd: EnvironmentFile=/var/www/html/deploy/kktbel.env
#   sudo cp /var/www/html/deploy/kktbel.service /etc/systemd/system/kktbel.service
#   sudo systemctl daemon-reload && sudo systemctl restart kktbel

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_ALLOWED_HOSTS=new.kktbel.ru,kktbel.ru,www.kktbel.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://new.kktbel.ru,https://kktbel.ru,https://www.kktbel.ru
DJANGO_SETTINGS_MODULE=techcollege_admin.settings

# HTTPS на публичном сайте (TLS перед nginx :8042)
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
# Включайте только если все поддомены тоже на HTTPS:
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
